# Get your token from https://zerro.app/token
ZENMONEY_TOKEN=your_token_here

# Optional: where synced snapshots are stored (one file per token hash).
# Defaults to ~/.cache/zenmoney-mcp (%LOCALAPPDATA%\zenmoney-mcp on Windows).
# ZENMONEY_CACHE_DIR=/path/to/cache

# Optional: seconds a snapshot is served without revalidating against the API.
# 0 (default) always runs a cheap incremental sync.
# ZENMONEY_CACHE_TTL=0

# Optional: set to 1 to disable on-disk caching entirely.
# ZENMONEY_NO_CACHE=1
